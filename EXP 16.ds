 application "Student Admission"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Admission_Enquiry_Form
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Date_of_birth
			(
    			type = date
				displayname = "Date of birth"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Gender
			(
				type = radiobuttons
				maxchar = 100
				values = {"Male","Female","Others"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Phone_Number
			(
    			type = phonenumber
				displayname = "Phone"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Parent_or_guardian
			(
    			type = text
				displayname = "Parent or guardian name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Marks_percentage
			(
				type = number
				displayname = "Marks percentage"
				maxchar = 3
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Preferred_counselling_time
			(
    			type = time
				displayname = "Preferred counselling time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Course_selection
			(
				type = picklist
				displayname = "Course selection"
				maxchar = 100
				values = {"AIML","AIDS","ECE"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Requires_Hostel_Accommodation
			(
    			type = checkbox
				displayname = "Do you require hostel accommodation?."
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Admission_Process_Guidelines_Display
			(
    			type = richtext
				displayname = "Admission Process Guidelines"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Achievement_Certificate_URL
			(
    			type = url
				displayname = "Achievement Certificate Link"
				enable  linkname
	 			row = 1
	 			column = 1   
				width = medium
			)
			Student_Photo
			(
    			type = image
				displayname = "Student Photograph"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Scholarship_Eligibility_Percent
			(
    			type = percentage
				displayname = "Scholarship Eligibility (%)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Application_Fee_Paid
			(
				displayname = "Application Fee Paid"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Entrance_Exam_Score
			(
				type = decimal
				displayname = "Entrance Examination Score"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Enquiry_Submitted_On2
			(
    			type = datetime
				displayname = "Enquiry Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have arent_Digital_Signature
			(
    			type = signature
				displayname = "arent/Guardian Digital Signature"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Sibling_Details
			(
				type = grid
				displayname = "Sibling Details"
				Name
				(
    				type = name
     				prefix
     				(
	     				 type = prefix
	     				 displayname ="Prefix"
	     				 visibility = false
	     				 value = {"Mr.","Mrs.","Ms."}
     				) 
     				first_name
     				(
	     				 type = first_name
	     				 displayname ="First Name"
     				) 
     				last_name
     				(
	     				 type = last_name
	     				 displayname ="Last Name"
     				) 
     				suffix
     				(
	     				 type = suffix
	     				 displayname ="Suffix"
	     				 visibility = false
     				) 
					width = medium
					personal data = true
				)
				Age
				(
					type = number
					width = medium
				)
				Class
				(
    				type = text
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Marksheet_Upload
			(
    			type = upload file
				displayname = "Class XII Marksheet"
				browse = local_drive
	 			row = 3
	 			column = 1   
				width = medium
			)
			Admission_Enquiry_ID
			(
    			type = autonumber
				displayname = "Admission Enquiry ID"
				start index = 1
	 			row = 3
	 			column = 1   
				width = medium
			)
			Statement_Of_Purpose_Audio1
			(
     			type = audio
				displayname = "Statement of Purpose Audio"
    			duration=60
	 			row = 3
	 			column = 1   
				width = medium
			)
			Formula
			(
				type = decimal
	 			row = 3
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  Application_Fee_Paid * (1 - Scholarship_Eligibility_Percent / 100)
    						visibility = false
    			)
			)
			QR_Code
			(
				type = qrcode
				displayname = "QR Code"
				value = "${Admission_Enquiry_ID}"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Section2
			(
				type = section
				displayname = "Section"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Admission_Enquiry_Form_Report
		{
			displayName = "Admission_Enquiry_Form Report"
			show all rows from Admission_Enquiry_Form    
			(
				Name 
				Email
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Phone_Number as "Phone"
				(
					displayformat = plainnumber 
				)
				Parent_or_guardian as "Parent or guardian name"
				Marks_percentage as "Marks percentage"
				Date_of_birth as "Date of birth"
				Preferred_counselling_time as "Preferred counselling time"
				Course_selection as "Course selection"
				Gender
				Requires_Hostel_Accommodation as "Do you require hostel accommodation?."
				Admission_Process_Guidelines_Display as "Admission Process Guidelines"
				Achievement_Certificate_URL as "Achievement Certificate Link"
				Student_Photo as "Student Photograph"
				Scholarship_Eligibility_Percent as "Scholarship Eligibility (%)"
				Application_Fee_Paid as "Application Fee Paid"
				Entrance_Exam_Score as "Entrance Examination Score"
